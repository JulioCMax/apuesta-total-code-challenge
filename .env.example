# Copy this file to `.env` and adjust values for local development.
# `.env` itself is gitignored; never commit real secrets.

# --- HTTP server -------------------------------------------------------
PORT=8080
APP_ENV=local
LOG_LEVEL=info

# --- AWS / DynamoDB ------------------------------------------------------
# DYNAMO_ENDPOINT overrides the SDK base endpoint for dynamodb-local.
# Leave it empty to talk to real AWS DynamoDB (used automatically in Lambda).
AWS_REGION=us-east-1
DYNAMO_TABLE=apuesta-total
DYNAMO_ENDPOINT=http://dynamodb:8000
# dynamodb-local accepts any non-empty static credentials.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Auth ----------------------------------------------------------------
# REQUIRED - boot fails fast if this is empty. Generate a strong random
# value for any real deployment; this placeholder is for local demo use only.
JWT_SECRET=local-development-only-change-me-please
JWT_TTL=1h

# --- Bet slip rules --------------------------------------------------------
BETSLIP_MIN_STAKE_AMOUNT=1
BETSLIP_MAX_STAKE_AMOUNT=10000
BETSLIP_CURRENCY_CODE=PEN
BETSLIP_MAX_SELECTIONS=20

# --- Platform --------------------------------------------------------------
# ulule/limiter format: "<limit>-<period>", e.g. 60 requests per minute.
RATE_LIMIT=60-M
IDEMPOTENCY_TTL=24h

# --- Demo seeding ------------------------------------------------------------
DEMO_ACCOUNT_INITIAL_BALANCE=1000
SEED_RESET=false

# --- Lambda runtime switch (read only; do not set locally) -----------------
# AWS_LAMBDA_FUNCTION_NAME is provided automatically by the Lambda runtime
# and selects the lambda.Start() code path instead of ListenAndServe().
# AWS_LAMBDA_FUNCTION_NAME=
